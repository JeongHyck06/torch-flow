        "01J9I003": {"label": "norm2", "type": "torch.nn.LayerNorm", "args": {"normalized_shape": {"$p": "dim"}}},
        "01J9I004": {"label": "mlp", "type": "composite:MLP", "args": {"dim": {"$p": "dim"}, "mult": 4}}
      },
      "nodes": [
        {"label": "norm1", "id": "01J9Q4A1", "call": "01J9I001", "method": "forward"},
        {"label": "attn",  "id": "01J9Q4A2", "call": "01J9I002", "method": "forward",
         "ports_out": [{"name": "y", "type": "Tensor"}]},
        {"label": "add1",  "id": "01J9Q4A3", "type": "torch.add"},
        {"label": "norm2", "id": "01J9Q4A4", "call": "01J9I003", "method": "forward"},
        {"label": "mlp",   "id": "01J9Q4A5", "call": "01J9I004", "method": "forward",
         "ports_out": [{"name": "y", "type": "Tensor"}]},
        {"label": "add2",  "id": "01J9Q4A6", "type": "torch.add"}
      ],
      "edges": [["$in.x", "01J9Q4A1.input"], ["01J9Q4A1.output", "01J9Q4A2.x"], ["$in.x", "01J9Q4A3.input"],
                ["01J9Q4A2.y", "01J9Q4A3.other"], ["01J9Q4A3.output", "01J9Q4A4.input"],
                ["01J9Q4A4.output", "01J9Q4A5.x"], ["01J9Q4A3.output", "01J9Q4A6.input"],
                ["01J9Q4A5.y", "01J9Q4A6.other"], ["01J9Q4A6.output", "$out.y"]]
    }
  },
  "graph": {
    "name": "MiniViT",
    "instances": {
      "01J9I101": {"label": "patch", "type": "composite:PatchEmbed",
                   "args": {"patch": {"$hp": "patch"}, "in_ch": 3, "dim": {"$hp": "dim"}}},
      "01J9I102": {"label": "blocks", "type": "torchflow.Repeat", "body": "composite:Block",
                   "count": {"$hp": "depth"}, "mode": "sequential",
                   "bind": {"dim": {"$hp": "dim"}, "heads": {"$hp": "heads"}, "attn_type": {"$hp": "attn_type"}}},
      "01J9I103": {"label": "head", "type": "torch.nn.Linear",
                   "args": {"in_features": {"$hp": "dim"}, "out_features": {"$expr": "rt.num_classes"}}}
    },
    "nodes": [
      {"label": "x", "id": "01J9Q4B1", "type": "torchflow.Input",
       "ports_out": [{"name": "x", "type": "Tensor", "shape": ["B", 3, 32, 32], "dtype": "float32"}]},
      {"label": "patch",  "id": "01J9Q4B2", "call": "01J9I101", "ports_out": [{"name": "y", "type": "Tensor"}]},
      {"label": "blocks", "id": "01J9Q4B3", "call": "01J9I102", "ports_out": [{"name": "y", "type": "Tensor"}]},
      {"label": "pool",   "id": "01J9Q4B4", "type": "torch.mean", "args": {"dim": 1}},
      {"label": "head",   "id": "01J9Q4B5", "call": "01J9I103", "method": "forward"},
      {"label": "logits", "id": "01J9Q4B6", "type": "torchflow.Output"}
    ],
    "edges": [["01J9Q4B1.x", "01J9Q4B2.x"], ["01J9Q4B2.y", "01J9Q4B3.x"], ["01J9Q4B3.y", "01J9Q4B4.input"],
              ["01J9Q4B4.output", "01J9Q4B5.input"], ["01J9Q4B5.output", "01J9Q4B6.input"]],
    "probes": [
      {"label": "gradflow", "id": "01J9Q4P1", "type": "probe.GradFlow",
       "on_edge": ["01J9Q4B3.y", "01J9Q4B4.input"], "auto_policy": "on_l0_ok"}
    ],
    "init": {"policy": "trunc_normal", "std": {"$hp": "init_std"}},
    "probe_objective": "auto"
  }
}
